{
  "name": "fmea-app",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "homepage": "https://github.com/STMARobotics/fmea-app#readme",
  "bugs": {
    "url": "https://github.com/STMARobotics/fmea-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STMARobotics/fmea-app.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test:backend": "npm run test --workspace=service -- --test-force-exit",
    "test:angular": "npm run test --workspace=ui -- --watch=false",
    "cdk:test": "npm run test --workspace=cdk",
    "test": "npm run test:backend && npm run test:angular && npm run cdk:test",
    "dev": "concurrently \"npm run dev -w service\" \"npm run dev -w ui\"",
    "dev:api": "npm run dev --workspace=service",
    "dev:ui": "npm run dev -w ui",
    "build": "npm run build --workspaces",
    "cdk:synth": "npm run synth --workspace=cdk",
    "cdk:diff": "npm exec -w cdk -- cdk diff --",
    "cdk:deploy": "npm run deploy --workspace=cdk"
  },
  "workspaces": [
    "cdk",
    "service",
    "ui"
  ],
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
