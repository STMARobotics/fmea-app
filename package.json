  "repository": {
    "type": "git",
    "url": "git+https://github.com/STMARobotics/fmea-app.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "dev": "concurrently \"npm run dev -w service\" \"npm run dev -w ui\"",
    "dev:api": "npm run dev --workspace=service",
    "dev:ui": "npm run dev -w ui",
    "build": "npm run build --workspaces",
    "cdk:synth": "npm run synth --workspace=cdk",
    "cdk:diff": "npm exec -w cdk -- cdk diff --",
    "cdk:deploy": "npm run deploy --workspace=cdk"
  },
  "workspaces": [
    "cdk",
    "service",
    "ui"
  ],
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
