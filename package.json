{
  "name": "fmea-app",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "homepage": "https://github.com/STMARobotics/fmea-app#readme",
  "bugs": {
    "url": "https://github.com/STMARobotics/fmea-app/issues"
